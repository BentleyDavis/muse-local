{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "Allows any visited site to return results for a pending page action",
  "local": false,
  "webviews": ["site"],
  "remote": {
    "urls": ["http://*/*", "https://*/*"]
  },
  "permissions": ["allow-page-result"]
}
